<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Hall Finder</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #eef3ff;
      text-align: center;
      padding: 30px 15px;
    }

    .box {
      background: white;
      max-width: 400px;
      margin: auto;
      padding: 25px;
      border-radius: 15px;
      box-shadow: 0 4px 15px #cccccc;
    }

    h1 {
      color: #174ea6;
    }

    input, button {
      width: 90%;
      padding: 12px;
      margin: 10px 0;
      font-size: 16px;
      border-radius: 8px;
    }

    input {
      border: 1px solid #aaa;
    }

    button {
      background: #174ea6;
      color: white;
      border: none;
      cursor: pointer;
    }

    #result {
      margin-top: 20px;
      font-size: 20px;
      font-weight: bold;
    }
  </style>
</head>

<body>
  <div class="box">
    <h1>🎓 Hall Finder</h1>
    <p>MSS College of Engineering, Jalna</p>
    <p>Enter your College Roll Number</p>

    <input
      type="number"
      id="roll"
      placeholder="Example: 1101"
    >

    <button onclick="findHall()">Find Hall Number</button>

    <div id="result"></div>
  </div>

  <script>
    function findHall() {
      const roll = Number(document.getElementById("roll").value);
      const result = document.getElementById("result");

      if (!Number.isInteger(roll) || roll < 1101 || roll > 1165) {
        result.innerHTML = "Please enter a Roll Number from 1101 to 1165.";
        return;
      }

      const serial = roll - 1100;
      const hall = "SF" + (11 + Math.floor((serial - 1) / 10));

      result.innerHTML =
        "Roll Number: " + roll +
        "<br>Hall Number: " + hall;
    }
  </script>
</body>
</html>
